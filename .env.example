# Base de données PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/noblotheque?schema=public"

# Auth.js — générer avec : npx auth secret
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# OAuth Google (facultatif)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
NEXT_PUBLIC_GOOGLE_AUTH="false"

# E-mails Resend (recommandé)
RESEND_API_KEY=""
# Pour tester sans domaine, utiliser : NobloThèque <onboarding@resend.dev>
MAIL_FROM="NobloThèque <noreply@votre-domaine.fr>"

# SMTP alternatif (facultatif)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# Administrateur créé par npm run db:seed
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
